# OpenDota (optional; increases API limits when supplied)
OPENDOTA_API_KEY=
OPENDOTA_API_URL=https://api.opendota.com/api
OPENDOTA_TIMEOUT=30
LOG_LEVEL=INFO

# DATABASE
POSTGRES_DB=dota2wardmap
POSTGRES_USER=dota2wardmap
POSTGRES_PASSWORD=dota2wardmap
POSTGRES_PORT=5432
# Custom-format PostgreSQL backup used by the maintenance db-restore service.
POSTGRES_RESTORE_PATH=../dota2wardmap-2026-08-25.dump
REDIS_PORT=6379
DB_URL=postgresql+psycopg2://dota2wardmap:dota2wardmap@localhost:5432/dota2wardmap
REDIS_URL=redis://localhost:6379/0

# PARSER
# Number of native parser child processes started by the separate worker.
PARSER_WORKERS=2
COLLECTOR_INTERVAL_SECONDS=300
# Rebuild league clusters after no new parsed replay has arrived for this many seconds.
CLUSTER_BATCH_DELAY_SECONDS=30
# Never postpone an active batch longer than this, even while parsing continues.
CLUSTER_BATCH_MAX_WAIT_SECONDS=120
JOB_RETENTION_DAYS=7
JOB_CLEANUP_INTERVAL_SECONDS=3600
CORS_ORIGINS=http://localhost:5173
ANONYMOUS_RATE_LIMIT_PER_MINUTE=60
ADVANCED_RATE_LIMIT_PER_MINUTE=600
# Zero disables rate limiting for administrators.
ADMIN_RATE_LIMIT_PER_MINUTE=0
ANONYMOUS_MAX_WARD_PAGE_SIZE=5000
ADVANCED_MAX_WARD_PAGE_SIZE=5000
ADMIN_MAX_WARD_PAGE_SIZE=10000
