#!/usr/bin/env bash

set -euo pipefail

readonly DEPLOY_USER="${WARDMAP_DEPLOY_USER:-artemrupasov}"
readonly DEPLOY_HOME="${WARDMAP_DEPLOY_HOME:-/home/$DEPLOY_USER}"
readonly BACKEND_DIR="$DEPLOY_HOME/projects/d2wm/dota2wardmap-back"
readonly FRONTEND_DIR="$DEPLOY_HOME/projects/d2wm/wardmap"
readonly TARGET="${1:-all}"

usage() {
    cat <<'EOF'
Usage: update-wardmap [all|backend|frontend]

Pull and rebuild the production Wardmap services. The default is all.
EOF
}

fail() {
    echo "update-wardmap: $*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

if [[ "$TARGET" == "help" || "$TARGET" == "-h" || "$TARGET" == "--help" ]]; then
    usage
    exit 0
fi

if [[ "$TARGET" != "all" && "$TARGET" != "backend" && "$TARGET" != "frontend" ]]; then
    usage >&2
    fail "unknown target: $TARGET"
fi

if [[ ${EUID} -eq 0 ]]; then
    require_command runuser
    exec runuser -u "$DEPLOY_USER" -- env \
        WARDMAP_DEPLOY_USER="$DEPLOY_USER" \
        WARDMAP_DEPLOY_HOME="$DEPLOY_HOME" \
        "$0" "$@"
fi

export PATH="$DEPLOY_HOME/.local/bin:$PATH"

require_command docker
require_command git
require_command flock
require_command curl

exec 9>"/tmp/wardmap-deploy-${DEPLOY_USER}.lock"
flock --nonblock 9 || fail "another Wardmap deployment is already running"

update_backend() {
    [[ -d "$BACKEND_DIR/.git" ]] || fail "backend checkout not found: $BACKEND_DIR"

    echo "Updating backend..."
    git -C "$BACKEND_DIR" pull --ff-only
    docker compose --project-directory "$BACKEND_DIR" \
        up --detach --build --remove-orphans --wait
}

update_frontend() {
    [[ -d "$FRONTEND_DIR/.git" ]] || fail "frontend checkout not found: $FRONTEND_DIR"

    echo "Updating frontend..."
    git -C "$FRONTEND_DIR" pull --ff-only
    git -C "$FRONTEND_DIR" lfs pull
    docker compose --project-directory "$FRONTEND_DIR" \
        up --detach --build --remove-orphans --wait
}

case "$TARGET" in
    all)
        update_backend
        update_frontend
        ;;
    backend)
        update_backend
        ;;
    frontend)
        update_frontend
        ;;
esac

echo "Verifying production endpoints..."
curl --fail --show-error --silent --output /dev/null https://api.rupasov.dev/health/ready
curl --fail --show-error --silent --output /dev/null https://wardmap.rupasov.dev/

echo "Deployment complete."
